# Dependencies are installed inside the image. Copying the host tree in would overwrite
# the Alpine/musl build of better-sqlite3 with the host's glibc build, which then fails
# to load with "ld-linux-x86-64.so.2: No such file or directory".
node_modules

# Build output is regenerated by the builder stage
.next

# Runtime data: SQLite database and downloaded audio. Mounted as a volume in production,
# must never be baked into the image.
data

# Version control and local tooling
.git
.gitignore
.claude

# Docker files themselves are not needed inside the build context
Dockerfile
.dockerignore

# Secrets are provided as runtime environment variables, never baked into the image
.env*
!.env.example

# Logs and docs
npm-debug.log*
yarn-error.log*
README.md
CLAUDE.md
